{
  "name": "claude-code-webview",
  "version": "0.1.0",
  "description": "Watch Claude Code sessions live in your browser, styled like Claude Desktop: file previews, bookmarks, an outline of your prompts, and — with herdr — sending prompts from the page.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "transcript",
    "session",
    "viewer",
    "webui",
    "herdr"
  ],
  "license": "MIT",
  "author": "Andrei Martyshchenko",
  "homepage": "https://github.com/andrew-mart/claude-code-webview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-mart/claude-code-webview.git"
  },
  "bugs": {
    "url": "https://github.com/andrew-mart/claude-code-webview/issues"
  },
  "type": "module",
  "bin": {
    "claude-code-webview": "bin/claude-code-webview.js"
  },
  "files": [
    "bin/",
    "cli/",
    "server/",
    "public/",
    "assets/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/claude-code-webview.js",
    "background": "node bin/claude-code-webview.js --background",
    "stop": "node bin/claude-code-webview.js --stop",
    "restart": "node bin/claude-code-webview.js --restart",
    "test": "node --test",
    "check": "tsc -p . && tsc -p tsconfig.sw.json",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@highlightjs/cdn-assets": "11.12.0",
    "@xterm/xterm": "^6.0.0",
    "docx-preview": "0.4.0",
    "dompurify": "3.4.16",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "file-views": "github:andrew-mart/file-views#v0.5.1",
    "jszip": "3.10.2",
    "lucide-static": "1.47.0",
    "marked": "18.1.0",
    "material-icon-theme": "5.38.1",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.2",
    "typescript": "5.9.3"
  }
}
